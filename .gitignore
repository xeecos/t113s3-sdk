# ============================================================
# T113-S3 Docker 编译环境 .gitignore
# 原则: 只保留脚本/配置/文档等源文件, 所有编译产物不入库
# ============================================================

# ---- 编译产物 (make 生成, 可随时重建) ----
out/

# ---- 拉取的源码与下载缓存 (make fetch 生成, 体积大) ----
sources/
downloads/

# ---- 编译缓存 ----
.ccache/

# ---- 全志官方 SDK 解包目录 (见 docs/vendor-sdk.md) ----
vendor/

# ---- 大体积二进制兜底 (防止误提交到仓库根目录) ----
*.img
*.ext4
*.squashfs
*.scr
*.dtb

# ---- 发布压缩包 ----
*.tar.gz
*.tgz
*.zip

# ---- 系统 / 编辑器文件 ----
.DS_Store
*.swp
*~
.idea/
.vscode/

# ---- 杂项临时文件 ----
*.log
*.tmp
.plist.tmp

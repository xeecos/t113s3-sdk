# ============================================================
# T113-S3 板级默认配置 (所有容器内编译脚本都会 source 本文件)
# 按自己的硬件修改后无需改动任何脚本
#
# 带透传的变量使用 ${VAR:-默认值} 写法: 宿主机/环境变量优先,
#   如 MIRROR=official make fetch、KERNEL_DTS=board make kernel
# ============================================================

export TARGET_SOC=t113-s3

# 配置文件命名主干 (下划线形式): configs/{kernel,uboot}/${CONFIG_STEM}.config
# 与 configs/buildroot/${CONFIG_STEM}_defconfig
export CONFIG_STEM="${CONFIG_STEM:-${TARGET_SOC//\-/_}}"

# 板级 DT 基础名 (board/dts/${BOARD_DTS_NAME}.dts 与
# board/uboot-dts/${BOARD_DTS_NAME}.dts 同名, U-Boot/内核 dtb 统一)
# 注意: 改名时同步更新 configs/uboot/${TARGET_SOC}.config 里的
# CONFIG_DEFAULT_DEVICE_TREE 和 configs/buildroot/ 的 defconfig 文件名
export BOARD_DTS_NAME="${BOARD_DTS_NAME:-sun8i-t113-s3}"

# ---- 交叉工具链 (armv7 Cortex-A7, hard-float) ----
export ARCH=arm
export CROSS_COMPILE=arm-linux-gnueabihf-

# ---- 源码版本 ----
# 内核: 主线 6.6 LTS tarball (TUNA 镜像下载, 比 git clone 快且稳)
#        可在 https://mirrors.tuna.tsinghua.edu.cn/kernel/v6.x/ 查最新版
export KERNEL_VER="${KERNEL_VER:-6.6.156}"
# U-Boot: 主线 v2025.01 (T113-S3 支持已合入)
export UBOOT_REF="${UBOOT_REF:-v2025.01}"
# busybox: 根文件系统基础 (tarball 版本号)
export BUSYBOX_REF="${BUSYBOX_REF:-1.36.1}"

# ---- U-Boot defconfig ----
# auto = 自动在源码 configs/ 里匹配含 "t113" 的 defconfig
# 也可手动指定, 例如: UBOOT_DEFCONFIG=sun8i_t113s_mangopi_mq_r_defconfig
export UBOOT_DEFCONFIG="${UBOOT_DEFCONFIG:-auto}"

# ---- U-Boot 板级 DT ----
# board = 使用 board/uboot-dts/ 下的板级 DT (含 uart3/mmc0/SPI flash 节点)
# auto  = 使用 defconfig 自带 DT (如 mangopi 参考板)
export UBOOT_DTS="${UBOOT_DTS:-board}"

# ---- 内核配置 ----
# 基础 defconfig (multi_v7 含 sunxi 平台), configs/kernel/${TARGET_SOC}.config 作为增量合并
export KERNEL_DEFCONFIG="${KERNEL_DEFCONFIG:-multi_v7_defconfig}"

# ---- 内核设备树 ----
# auto  = 自动选用上游 sun8i-t113*.dts 中第一个 (如 MangoPi MQ-R)
# board = 使用本项目 board/dts/ 下与 BOARD_DTS_NAME 同名的 DTS 模板
# 其他  = 内核树内已存在的 DTS 文件名 (不含 .dts 后缀)
export KERNEL_DTS="${KERNEL_DTS:-auto}"

# ---- 源码镜像 ----
# official = 官方源 (git.kernel.org / denx.de)
# cn       = 中国镜像 (TUNA / Gitee), 大幅加速 git clone
export MIRROR="${MIRROR:-cn}"

# ---- SD 卡镜像布局 (pack-image.sh 使用) ----
export SD_BOOT_OFFSET_MB=8      # Boot 分区起始 (8MiB, 前 8KiB 放 U-Boot)
export SD_BOOT_SIZE_MB=128      # Boot 分区大小 (FAT32)
export ROOTFS_SIZE_MB=192       # rootfs.ext4 大小 (busybox 最小根文件系统足够)

# ---- SPI Flash 镜像布局 (pack-spi.sh 使用) ----
export SPI_FLASH_SIZE_MB="${SPI_FLASH_SIZE_MB:-16}"  # NOR 容量: 16 或 32 (MB)
export SPI_ROOTFS="${SPI_ROOTFS:-1}"                 # 1 = squashfs rootfs 也打进 SPI (全 NOR 系统, 默认)
# 布局: 0x0 U-Boot(512K) | 0x80000 dtb(64K) | 0x100000 zImage(12M) | 0xD00000 rootfs(剩余空间)

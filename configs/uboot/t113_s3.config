# ============================================================
# T113-S3 U-Boot 增量配置 (在 UBOOT_DEFCONFIG 基础上合并)
# 见 scripts/build-uboot.sh
# ============================================================

# ---- SPI Flash (SPI0: PC2~PC5) ----
# SPI NOR: sf probe/read/write/erase
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SPI_SUNXI=y
CONFIG_MTD=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_STMICRO=y
CONFIG_SF_DEFAULT_BUS=0
CONFIG_SF_DEFAULT_CS=0
CONFIG_SF_DEFAULT_SPEED=40000000
CONFIG_SF_DEFAULT_MODE=0

# SPI NAND: mtd list / mtd read / mtd write / mtd erase
#   MTD_SPI_NAND 依赖 DM_MTD + DM_SPI, 自身 select SPI_MEM/MTD_NAND_CORE;
#   sunxi SPI 控制器驱动只实现 dm_spi_ops, SPI NAND 通过 spi-mem 的
#   spi_xfer 回退路径访问 (drivers/spi/spi-mem.c), 无需额外改动。
#   芯片表在 drivers/mtd/nand/spi/winbond.c, U-Boot 2025.01 已内置 W25N02KV。
CONFIG_SPI_MEM=y
CONFIG_DM_MTD=y
CONFIG_MTD_NAND_CORE=y
CONFIG_MTD_SPI_NAND=y
CONFIG_CMD_MTD=y

# ---- SPL 自己从 SPI flash 读 U-Boot proper (不再需要 SD 卡里有 U-Boot) ----
# SPL_SPI_SUNXI: sunxi SPL 直接驱动 SPI 控制器读 flash 的实现
#                (arch/arm/mach-sunxi/spl_spi_sunxi.c, T113 的时钟/引脚分支已在其中)
# SPL_SPINAND_SUPPORT: 在它基础上增加 SPI NAND 读法 (Page Data Read + Read From Cache)。
#                加载前会先读芯片 ID: Winbond SPI NAND = EF AA xx, SPI NOR = EF 40 xx,
#                所以同一份 SPL 在 NAND / NOR 板上都能自动选对路径。
# SPL_SPINAND_PAGE_SIZE: 必须是板上 NAND 的页大小 (W25N02KV = 2048 = 0x800)
CONFIG_SPL_SPI_SUNXI=y
CONFIG_SPL_SPINAND_SUPPORT=y
CONFIG_SPL_SPINAND_PAGE_SIZE=0x800

# ---- 启动流程: SPI flash (全 flash 系统) 优先, 失败后 SD 卡 distro 启动 ----
# 布局见 scripts/pack-spi.sh 与 board/dts|uboot-dts/${BOARD_DTS_NAME}.dts
#   SPI_FLASH_TYPE=nand (默认, W25N02KVZEIR):
#     0x0 uboot(1M) | 0x100000 dtb(256K) | 0x140000 kernel(16M) | 0x1140000 rootfs
#   SPI_FLASH_TYPE=nor:
#     0x0 uboot(512K) | 0x80000 dtb(64K) | 0x100000 kernel(12M) | 0xD00000 rootfs
# 分区名(uboot/dtb/kernel/rootfs)来自板级 DT 的 partitions 节点, 内核同样用它,
# 所以这里不需要 cmdline mtdparts; rootfs 是第 4 个分区 -> root=/dev/mtdblock3
# 调试串口: T113-S3 为 UART3 (PB6/PB7) -> console=ttyS3
# SD 卡默认是用户数据盘; 插旧版开发 SD 镜像 (含 boot.scr) 仍可作恢复启动
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if mtd read dtb ${fdt_addr_r}; then mtd read kernel ${kernel_addr_r}; setenv bootargs console=ttyS3,115200 root=/dev/mtdblock3 rootfstype=squashfs rootwait panic=10; bootz ${kernel_addr_r} - ${fdt_addr_r}; fi; mmc dev 0; run distro_bootcmd"
# SPI NOR 板改用这一行 (sf 命令, 偏移必须与 scripts/pack-spi.sh 的 nor 布局一致):
# CONFIG_BOOTCOMMAND="sf probe; sf read ${kernel_addr_r} 0x100000 0xc00000; sf read ${fdt_addr_r} 0x80000 0x10000; setenv bootargs console=ttyS3,115200 mtdparts=spi0.0:512k(uboot)ro,64k(dtb),12m(kernel),-(rootfs) root=/dev/mtdblock3 rootfstype=squashfs rootwait panic=10; bootz ${kernel_addr_r} - ${fdt_addr_r}; mmc dev 0; run distro_bootcmd"

# ---- U-Boot 环境变量存放位置 ----
# 下面这条是给 SPI NOR 板用的 (偏移/大小沿用 sunxi defconfig 默认值:
# offset 0xF0000 / size 64K, 落在 nor 布局里 uboot 与 kernel 分区之间的空隙)。
# SPI NAND 板上没有 NOR, env_init 会回退到编译进去的默认环境: 能正常启动,
# 但 saveenv 不可用 (纯净 SPI NAND 板想持久化 env 需要 UBI, 见 docs/spi-nand.md)。
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_SPI_BUS=0
CONFIG_ENV_SPI_CS=0
CONFIG_ENV_SPI_MAX_HZ=40000000
CONFIG_ENV_SPI_MODE=0

# ---- 使用本项目板级 DT (含 uart3/mmc0/spi0, 见 board/uboot-dts/) ----
# 由 build-uboot.sh 在 UBOOT_DTS=board 时复制进源码树
# (与内核 dtb 同名, boot.cmd 里用 ${fdtfile} 引用)
CONFIG_DEFAULT_DEVICE_TREE="sun8i-t113-s3"

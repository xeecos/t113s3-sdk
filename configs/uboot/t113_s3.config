# ============================================================
# T113-S3 U-Boot 增量配置 (在 UBOOT_DEFCONFIG 基础上合并)
# 见 scripts/build-uboot.sh
# ============================================================

# ---- SPI Flash (SPI0: PC2~PC5), 使能 sf probe/read/write/erase ----
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SPI_SUNXI=y
CONFIG_MTD=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_STMICRO=y
CONFIG_SF_DEFAULT_BUS=0
CONFIG_SF_DEFAULT_CS=0
CONFIG_SF_DEFAULT_SPEED=40000000
CONFIG_SF_DEFAULT_MODE=0

# ---- 启动流程: SD 卡优先, 失败后从 SPI flash 加载内核/DTB ----
# SPI flash 布局见 scripts/pack-spi.sh:
#   0x80000 dtb (64K) / 0x100000 zImage (10M) / 0xB00000 rootfs(可选)
# 调试串口: T113-S3 为 UART3 (PB6/PB7) -> console=ttyS3
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="mmc dev 0; run distro_bootcmd; sf probe; sf read ${kernel_addr_r} 0x100000 0xa00000; sf read ${fdt_addr_r} 0x80000 0x10000; setenv bootargs console=ttyS3,115200 root=/dev/mmcblk0p2 rootwait panic=10; bootz ${kernel_addr_r} - ${fdt_addr_r}"

# ---- 使用本项目板级 DT (含 uart3/mmc0/spi0, 见 board/uboot-dts/) ----
# 由 build-uboot.sh 在 UBOOT_DTS=board 时复制进源码树
# (与内核 dtb 同名, boot.cmd 里用 ${fdtfile} 引用)
CONFIG_DEFAULT_DEVICE_TREE="sun8i-t113-s3"

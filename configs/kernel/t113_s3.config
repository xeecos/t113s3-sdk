# T113-S3 内核增量配置 (在 KERNEL_DEFCONFIG 基础上合并, 见 scripts/build-kernel.sh)
# 仅保证 T113-S3 启动所需的关键驱动, 按外设需要自行增补

# 串口 (sunxi 8250 兼容)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# SD/MMC (启动介质)
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y

# 千兆 EMAC
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_MICREL_PHY=y

# RTC / 看门狗 / 温度
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_SUN8I_THERMAL=y

# USB (OTG/MUSB)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_PHY_SUN4I_USB=y

# SPI (sun6i 兼容控制器)
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y

# 文件系统 (boot 分区为 FAT32)
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- SPI Flash (SPI0: PC2~PC5, /dev/mtd*) ----
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_CMDLINE_PARTS=y
# SPI NOR (16/32MB NOR 板)
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
# SPI NAND (W25N02KVZEIR 等; MTD_SPI_NAND 会连带 select SPI_MEM / MTD_NAND_CORE /
# MTD_NAND_ECC, 片内 ECC 由驱动自带的 on-die engine 处理, 不需要软件 ECC)
# 芯片表见 drivers/mtd/nand/spi/winbond.c, 6.6 起内置 W25N02KV (ID ef aa 22), 无需额外补丁
CONFIG_MTD_SPI_NAND=y

# SquashFS (SPI flash 只读根文件系统用, zstd 压缩)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
